[Unit]
Description=CNTRL published pages (static, read-only)
After=network-online.target

[Service]
WorkingDirectory=%h/cntrl
# The pages server reads only <data_dir>/pages (snapshots the operator approved)
# and answers GET/HEAD. It runs beside cntrl.service, never inside it, so a
# published page is never on the app's port. Its port and bind address come from
# CNTRL_PAGES_PORT / CNTRL_PAGES_BIND (the same env file as the app).
ExecStart=%h/cntrl/.venv/bin/python -m backend.pages_server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
